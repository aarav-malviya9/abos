{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@abos/core/*": ["packages/core/src/*"],
      "@abos/agents/*": ["packages/agents/src/*"],
      "@abos/dashboard/*": ["packages/dashboard/src/*"],
      "@abos/api/*": ["packages/api/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}