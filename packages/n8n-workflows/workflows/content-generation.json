{
  "name": "Content Generation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "value": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily at 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "const projects = [\n  // In real implementation, fetch active projects from API\n  { id: 'proj-1', name: 'Project Alpha' },\n  { id: 'proj-2', name: 'Project Beta' }\n];\n\nconst contentTypes = ['blog', 'social', 'newsletter'];\n\nreturn projects.flatMap(p =>\n  contentTypes.map(type => ({ json: { projectId: p.id, projectName: p.name, contentType: type } }))\n);"
      },
      "id": "get-projects",
      "name": "Get Active Projects",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/agents/execute",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "parameters": {
          "agentType": "marketing",
          "action": "create-content",
          "payload": {
            "projectId": "={{ $json.projectId }}",
            "contentType": "={{ $json.contentType }}",
            "topic": "={{ $json.contentType === 'blog' ? 'Industry insights' : $json.contentType === 'social' ? 'Quick tip' : 'Weekly update' }}"
          }
        }
      },
      "id": "generate-content",
      "name": "Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst successful = items.filter(item => item.json.success).length;\n\nreturn [{ json: { generated: successful, total: items.length, message: `Generated ${successful}/${items.length} content pieces` } }];"
      },
      "id": "summarize",
      "name": "Summarize Generation",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Daily at 8 AM": {
      "main": [
        [
          {
            "node": "Get Active Projects",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Projects": {
      "main": [
        [
          {
            "node": "Generate Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Content": {
      "main": [
        [
          {
            "node": "Summarize Generation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "content-generation"
}