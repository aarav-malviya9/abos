      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "functionCode": "const period = $node.name.includes('Daily') ? 'daily' : $node.name.includes('Weekly') ? 'weekly' : 'monthly';\nreturn [{ json: { agentType: 'finance', action: 'financial-report', payload: { period } } }];"
      },
      "id": "create-daily-task",
