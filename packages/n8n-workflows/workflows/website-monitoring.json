{
  "name": "Website Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "value": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { agentType: 'operations', action: 'website-monitoring', payload: {} } }];"
      },
      "id": "create-task",
      "name": "Create Monitoring Task",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/agents/execute",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "parameters": {
          "agentType": "={{ $json.agentType }}",
          "action": "={{ $json.action }}",
          "payload": "={{ $json.payload }}"
        }
      },
      "id": "execute-monitoring",
      "name": "Execute Website Monitoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ !$json.success || ($json.output?.metrics?.uptime !== undefined && $json.output.metrics.uptime < 99) }}",
              "operation": "true"
            }
          ]
        }
      },
      "id": "check-status",
      "name": "Check Site Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/alerts",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "parameters": {
          "type": "website_down",
          "message": "Website monitoring detected issues",
          "severity": "critical"
        }
      },
      "id": "alert-down",
      "name": "Alert - Site Down",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Create Monitoring Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Monitoring Task": {
      "main": [
        [
          {
            "node": "Execute Website Monitoring",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Website Monitoring": {
      "main": [
        [
          {
            "node": "Check Site Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Site Status": {
      "main": [
        [
          {
            "node": "Alert - Site Down",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "website-monitoring"
}